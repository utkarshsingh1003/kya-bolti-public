# ---------------------------------------------------------------------------
# Kya Bolti Public — environment variables
# Copy to .env.local (git-ignored) and fill in real values. Never commit .env*.
# ---------------------------------------------------------------------------

# Public site URL used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://kyaboltipublic.in

# Storage backend. Leave unset (or empty) for the local JSON file store used in
# development. SET THIS for persistent production storage, e.g. a Supabase
# PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Without DATABASE_URL, Vercel production deployments refuse to silently fall
# back to in-memory storage and return a clear storage error.
DATABASE_URL=

# Local JSON file store location (defaults to <repo>/.data/store.json).
KBP_DATA_DIR=.data

# Force demo/offline news mode (used by tests): KBP_DISABLE_LIVE_NEWS=1
# KBP_DISABLE_LIVE_NEWS=0

# Optional: switch the file store backend explicitly (memory | file).
# KBP_FILE_STORE=file

# Admin area (required for /admin). No defaults — the deployment must set both.
# ADMIN_PASSWORD=change-me-12-plus-chars
# ADMIN_SESSION_SECRET=generate-a-long-random-hmac-secret

# Shared secret for the /api/cron/news Vercel cron endpoint.
# CRON_SECRET=generate-a-long-random-cron-secret

# Optional language code for assistant vocabulary (default: hi).
# BOOK_LANG=hi
